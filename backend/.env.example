# 复制本文件为 .env 后按需修改。
# .env 已被 .gitignore 排除，不要提交到仓库。
#
# API Key 由后端统一持有，用户无需自备；前端不得接触任何密钥，
# 所有模型调用一律经后端代理（见《项目前置文档》11.2 / 12.5）。

# ── 模型 ────────────────────────────────────────
# 换成通义千问 / 智谱 GLM 时只改这几行，无需改代码
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 当前 DeepSeek 在售：deepseek-flash（本项目选用）、deepseek-v4-pro
# 注意：两者都是带推理的模型，reasoning_content 计入输出 token。
# max_tokens 给太小，推理会把预算吃光，模型返回 finish_reason=length
# 且一个工具都不调用——不报错、静默失败。故此处给足。
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8000

# ── 服务 ────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 存储 ────────────────────────────────────────
# 留空则用 backend/data
DATA_DIR=

# ── 循环上限（见前置文档 4.2 / 4.3）─────────────
# 两个上限独立计：多轮问答不挤占工具调用轮数
MAX_TOOL_TURNS=12
MAX_QUESTIONS=5
SESSION_TIMEOUT_MINUTES=30
